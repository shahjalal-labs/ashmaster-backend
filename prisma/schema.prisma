datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//w: (start)╭────────────  PendingUser  ────────────╮
model PendingUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  fullname  String
  fcmToken  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Pending_users")
}

//w: (end)  ╰────────────  PendingUser  ────────────╯

//w: (start)╭────────────  User  ────────────╮
model User {
  id                        String              @id @default(auto()) @map("_id") @db.ObjectId
  email                     String              @unique
  password                  String?
  fullname                  String
  fcmToken                  String?
  role                      UserRole            @default(MENTEE)
  profilStatus              ProfilStatus        @default(INCOMPLETE)
  profile                   Profile?
  preference                Preference?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  connectionReqSender ConnectionRequest[] @@relation("SentRequests")
  connectionReqReciever ConnectionRequest[]
  Connection                Connection[]
  Connection                Connection[]

  @@map("users")
}

//w: (end)  ╰────────────  User  ────────────╯

//w: (start)╭────────────  Profile  ────────────╮
model Profile {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  about          String
  age            Int
  ethnicity      Ethnicity
  gender         Gender
  profession     String
  experienceYear Int
  availability   Json
  profileImage   String?
  interests      String[]  @default([])
  userId         String    @unique @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("profiles")
}

//w: (end)  ╰──────────── Profile   ────────────╯

//w: (start)╭────────────  Preference  ────────────╮
model Preference {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  career    String
  gender    Gender
  ethnicity Ethnicity
  notes     String?
  age       AgeRange
  userId    String    @unique @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

//w: (end)  ╰──────────── Preference   ────────────╯

//w: (start)╭──────────── ConnectionRequest  ────────────╮
model ConnectionRequest {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String        @db.ObjectId
  sender     User          @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String        @db.ObjectId
  receiver   User          @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  message    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId, status])
  @@index([receiverId, status])
  @@map("connection_requests")
}

model Connection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user1Id   String   @db.ObjectId
  user1     User     @relation("Connections1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String   @db.ObjectId
  user2     User     @relation("Connections2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("connections")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

//w: (end)  ╰──────────── ConnectionRequest  ────────────╯

enum UserRole {
  MENTOR
  MENTEE
  ADMIN
}

enum Ethnicity {
  BLACK
  EAST_ASIAN
  HISPANIC
  MIDDLE_EASTERN
  NATIVE_AMERICAN
  PACIFIC_ISLANDER
  NO_ANSWER // prefer not to say
}

enum Gender {
  MALE
  FEMALE
  NO_ANSWER
}

enum ProfilStatus {
  COMPLETE
  INCOMPLETE
}

type AgeRange {
  min Int
  max Int
}
